# Environment Configuration for Remote Access
# Copy this file to .env and update with your server IP

# Server IP Address (auto-detect: ./scripts/detect-ip.sh)
SERVER_IP=192.168.1.100

# Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
KEYCLOAK_PORT=8080
VAULT_PORT=8200
WIREGUARD_PORT=51820

# URLs (will be auto-configured based on SERVER_IP)
FRONTEND_URL=http://${SERVER_IP}:${FRONTEND_PORT}
BACKEND_URL=http://${SERVER_IP}:${BACKEND_PORT}
KEYCLOAK_URL=http://${SERVER_IP}:${KEYCLOAK_PORT}
VAULT_URL=http://${SERVER_IP}:${VAULT_PORT}

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=company
KEYCLOAK_CLIENT_ID=vpn-client
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Vault Configuration
VAULT_TOKEN=myroot

# Database
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# WireGuard
WIREGUARD_SUBNET=10.0.0.0
